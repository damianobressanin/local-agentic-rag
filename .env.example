# ── LLM provider (OpenAI-compatible endpoint) ──────────────────
# Change these to switch provider (e.g. vLLM, OpenAI cloud, etc.)
LLM_BASE_URL= # Base URL OpenAI-compatible endpoint
LLM_MODEL= # Model name or identifier (e.g. "gpt-3.5-turbo", "gpt-4", "openai/gpt-oss-20b")
LLM_API_KEY= # API key for authentication (if required by your provider)
LLM_TEMPERATURE= # Adjust the creativity of the responses (0.0 = deterministic, 1.0 = more creative)

# ── Langfuse (optional, for observability/tracing) ─────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# ── Chat session (optional) ────────────────────────────────────
# If unset, a random session id is generated at startup.
CHAT_SESSION_ID=
