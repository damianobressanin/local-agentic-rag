# ── LLM provider (OpenAI-compatible endpoint) ──────────────────
# Change these to switch provider (e.g. vLLM, OpenAI cloud, etc.)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.7

# ── Langfuse (optional, for observability/tracing) ─────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000

# ── Embedding model (OpenAI-compatible endpoint) ───────────────
# Used for RAG ingestion and retrieval. Can be the same LMStudio server.
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@f32
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1

# ── Qdrant (vector database) ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents

# ── RAG retrieval pipeline (optional — sensible defaults in code) ──
# Uncomment and change only if you want to override the defaults.
# RAG_RETRIEVAL_K=12
# RAG_SCORE_THRESHOLD=0.65
# RAG_RERANK_TOP_N=6
# RAG_MAX_CONTEXT_CHUNKS=4
# RAG_VERBOSE_CHUNK_LOGGING=true

# ── Chat session (optional) ────────────────────────────────────
# If unset, a random session id is generated at startup. LangFuse uses this to group all interactions in the same session together for better observability.
# CHAT_SESSION_ID= 
